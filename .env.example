# Code Signing (only needed for release builds)
# Get these from your Apple Developer account
# See: https://blackboard.sh/electrobun/docs/guides/code-signing

# Your Developer ID certificate name (e.g., "Your Name" or "Company Name")
DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"

# Team ID from Apple Developer Portal (App ID Prefix)
TEAMID="YOURTEAMID"

# Your Apple ID email
APPLEID="you@example.com"

# App-specific password from https://account.apple.com/sign-in
APPLEIDPASS="xxxx-xxxx-xxxx-xxxx"
